---
import { marked } from "marked";

interface Props {
  markdown: string;
  title?: string;
}

const { markdown, title } = Astro.props;
const html = marked.parse(markdown || "", { breaks: true }) as string;
---

<section class="article-prose-shell">
  <article class="article-prose">
    {title && <h1 class="text-3xl font-semibold leading-tight text-ink-900">{title}</h1>}
    <div set:html={html}></div>
  </article>
</section>

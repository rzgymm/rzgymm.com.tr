---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ArticleContent from "../../components/ArticleContent.astro";
import basePage from "../../data/pages/haberler.json";
import newsData from "../../data/haberler.json";

type NewsPost = {
  slug: string;
  title: string;
  excerpt: string;
  date: string;
  coverImage: string;
  body: string;
};

export function getStaticPaths() {
  const posts = newsData.posts as NewsPost[];
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: NewsPost };
const publishedDate = new Date(post.date).toLocaleDateString("tr-TR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const page = {
  ...basePage,
  path: `/haberler/${post.slug}/`,
  menuLabel: "Haberler",
  metaTitle: `${post.title} | Haberler | RZG YMM`,
  metaDescription: post.excerpt,
  heroBadge: "HABERLER",
  heroTitle: post.title,
  heroDescription: post.excerpt,
  heroImage: post.coverImage || basePage.heroImage,
  body: post.body,
};
---

<SiteLayout page={page} currentPath={`/haberler/${post.slug}/`}>
  <section class="container-shell pb-8 pt-12 sm:pt-16">
    <div class="news-article-head">
      <a href="/haberler/" class="news-back-link">← Tüm Haberler</a>
      <p class="news-date">{publishedDate}</p>
    </div>
  </section>

  <ArticleContent markdown={post.body} />
</SiteLayout>

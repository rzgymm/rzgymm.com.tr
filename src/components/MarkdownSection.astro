---
import { marked } from "marked";

interface Props {
  markdown: string;
  compactTop?: boolean;
  introHighlights?: { title: string; description: string }[];
}

type Block = {
  title: string;
  tokens: any[];
};

type Section = {
  title: string;
  introTokens: any[];
  blocks: Block[];
};

const { markdown, compactTop = false, introHighlights = [] } = Astro.props;
const tokens = marked.lexer(markdown || "");

const introTokens: any[] = [];
const sections: Section[] = [];

let currentSection: Section | null = null;
let currentBlock: Block | null = null;

for (const token of tokens) {
  if (token.type === "heading" && token.depth === 2) {
    if (currentSection) {
      sections.push(currentSection);
    }

    currentSection = {
      title: token.text,
      introTokens: [],
      blocks: [],
    };
    currentBlock = null;
    continue;
  }

  if (!currentSection) {
    introTokens.push(token);
    continue;
  }

  if (token.type === "heading" && token.depth === 3) {
    currentBlock = {
      title: token.text,
      tokens: [],
    };
    currentSection.blocks.push(currentBlock);
    continue;
  }

  if (currentBlock) {
    currentBlock.tokens.push(token);
  } else {
    currentSection.introTokens.push(token);
  }
}

if (currentSection) {
  sections.push(currentSection);
}

const introHtml = introTokens.length ? marked.parser(introTokens as any) : "";
---

<section class:list={["container-shell pb-20 sm:pb-24", compactTop ? "pt-3 sm:pt-5" : "pt-16 sm:pt-20"]}>
  {introHtml && (
    <article class="content-markdown intro-premium section-flat p-0" set:html={introHtml}></article>
  )}

  <div class="space-y-10">
    {
      sections.map((section, sectionIndex) => {
        const sectionIntroHtml = section.introTokens.length
          ? marked.parser(section.introTokens as any)
          : "";
        const isFaqSection = section.title.toLocaleLowerCase("tr-TR").includes("sıkça sorulan");
        const introParagraphs = section.introTokens
          .filter((token: any) => token.type === "paragraph")
          .map((token: any) => token.text?.trim())
          .filter(Boolean) as string[];
        const isHomeIntroRich = compactTop && sectionIndex === 0 && !isFaqSection && section.blocks.length === 0 && introParagraphs.length > 0;
        const introBody = introParagraphs.length > 2 ? introParagraphs.slice(2).join(" ") : "";

        return (
          <section class="section-shell">
            {isHomeIntroRich ? (
              <div class="home-intro-rich">
                <div class="home-intro-main">
                  <p class="home-intro-eyebrow">{section.title}</p>
                  {introParagraphs[0] && <h2 class="home-intro-subtitle">{introParagraphs[0]}</h2>}
                  {introParagraphs[1] && <h3 class="home-intro-lead">{introParagraphs[1]}</h3>}
                  {introBody && <p class="home-intro-body">{introBody}</p>}

                  {
                    introHighlights.length > 0 && (
                      <div class="home-intro-points">
                        {
                          introHighlights.map((item, idx) => (
                            <article class="home-intro-point">
                              <span class="home-intro-point-icon" aria-hidden="true">
                                {
                                  idx % 3 === 0 ? (
                                    <svg viewBox="0 0 24 24" fill="none">
                                      <path d="M12 3 5 6v5c0 5.1 3.3 9.9 7 11 3.7-1.1 7-5.9 7-11V6l-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                      <path d="m9.4 12.1 1.8 1.8 3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                  ) : idx % 3 === 1 ? (
                                    <svg viewBox="0 0 24 24" fill="none">
                                      <path d="M3.5 18.5h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                      <path d="M7.5 15v-4m4 4V6m4 9v-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                    </svg>
                                  ) : (
                                    <svg viewBox="0 0 24 24" fill="none">
                                      <path d="M4 19V9m8 10V5m8 14v-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                      <path d="M4 19h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                                    </svg>
                                  )
                                }
                              </span>
                              <div>
                                <h4>{item.title}</h4>
                                <p>{item.description}</p>
                              </div>
                            </article>
                          ))
                        }
                      </div>
                    )
                  }
                </div>

                <div class="home-intro-visual" aria-hidden="true">
                </div>
              </div>
            ) : (
              <div class="section-shell-head">
                <h2>{section.title}</h2>
                {sectionIntroHtml && (
                  <div class={`content-markdown ${section.blocks.length === 0 ? "section-story" : ""}`} set:html={sectionIntroHtml}></div>
                )}
              </div>
            )}

            {section.blocks.length > 0 &&
              (isFaqSection ? (
                <div class="faq-accordion mt-6">
                  {
                    section.blocks.map((block, index) => {
                      const blockHtml = marked.parser(block.tokens as any);
                      const faqId = `faq-item-${section.title.replaceAll(" ", "-").toLowerCase()}-${index}`;
                      return (
                        <article class="faq-item" data-faq-item>
                          <button type="button" class="faq-trigger" aria-expanded={index === 0 ? "true" : "false"} aria-controls={faqId}>
                            <span class="faq-index">{String(index + 1).padStart(2, "0")}</span>
                            <span class="faq-question">{block.title}</span>
                            <span class="faq-chevron">+</span>
                          </button>
                          <div id={faqId} class={`faq-content ${index === 0 ? "is-open" : ""}`} data-faq-content>
                            <div class="content-markdown faq-content-inner" set:html={blockHtml}></div>
                          </div>
                        </article>
                      );
                    })
                  }
                </div>
              ) : (
                <div class="section-block-grid">
                  {
                    section.blocks.map((block) => {
                      const blockHtml = marked.parser(block.tokens as any);

                      return (
                        <article class="section-block-card">
                          <h3>{block.title}</h3>
                          <div class="content-markdown" set:html={blockHtml}></div>
                        </article>
                      );
                    })
                  }
                </div>
              ))}
          </section>
        );
      })
    }
  </div>
</section>

<script>
  const faqItems = Array.from(document.querySelectorAll("[data-faq-item]"));
  faqItems.forEach((item) => {
    const trigger = item.querySelector(".faq-trigger");
    const content = item.querySelector("[data-faq-content]");
    const chevron = item.querySelector(".faq-chevron");
    if (!(trigger instanceof HTMLElement) || !(content instanceof HTMLElement) || !(chevron instanceof HTMLElement)) return;

    if (content.classList.contains("is-open")) {
      content.style.maxHeight = `${content.scrollHeight}px`;
      chevron.textContent = "−";
    }

    trigger.addEventListener("click", () => {
      const isExpanded = trigger.getAttribute("aria-expanded") === "true";
      faqItems.forEach((other) => {
        const otherTrigger = other.querySelector(".faq-trigger");
        const otherContent = other.querySelector("[data-faq-content]");
        const otherChevron = other.querySelector(".faq-chevron");
        if (!(otherTrigger instanceof HTMLElement) || !(otherContent instanceof HTMLElement) || !(otherChevron instanceof HTMLElement)) return;

        otherTrigger.setAttribute("aria-expanded", "false");
        otherContent.classList.remove("is-open");
        otherContent.style.maxHeight = "0px";
        otherChevron.textContent = "+";
      });

      if (!isExpanded) {
        trigger.setAttribute("aria-expanded", "true");
        content.classList.add("is-open");
        content.style.maxHeight = `${content.scrollHeight}px`;
        chevron.textContent = "−";
      }
    });
  });
</script>

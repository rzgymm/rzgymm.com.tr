---
import SiteLayout from "../../layouts/SiteLayout.astro";
import MarkdownSection from "../../components/MarkdownSection.astro";
import page from "../../data/pages/duyurular.json";
import announcementsData from "../../data/duyurular.json";

type AnnouncementPost = {
  slug: string;
  title: string;
  excerpt: string;
  date: string;
  coverImage: string;
  body: string;
  category?: string;
};

const posts = [...(announcementsData.posts as AnnouncementPost[])].sort((a, b) =>
  b.date.localeCompare(a.date),
);

const formatDate = (rawDate: string) =>
  new Date(rawDate).toLocaleDateString("tr-TR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
---

<SiteLayout page={page} currentPath="/duyurular/">
  <section class="container-shell pb-20 pt-16 sm:pb-24 sm:pt-20">
    <div class="news-grid">
      {
        posts.map((post) => (
          <article class="news-card">
            <a href={`/duyurular/${post.slug}/`} class="news-cover">
              <img src={post.coverImage} alt={post.title} loading="lazy" class="hidden" />
            </a>

            <div class="news-content">
              <p class="news-date">{formatDate(post.date)}</p>
              <h2>
                <a href={`/duyurular/${post.slug}/`}>{post.title}</a>
              </h2>
              <p>{post.excerpt}</p>

              <div class="mt-6 flex items-center justify-between gap-3">
                <a class="news-link mt-0" href={`/duyurular/${post.slug}/`}>
                  Devamını oku...
                </a>

                {post.category && (
                  <span class="inline-flex max-w-[58%] items-center truncate rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-600">
                    {post.category}
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {posts.length === 0 && <MarkdownSection markdown={page.body} />}
</SiteLayout>
